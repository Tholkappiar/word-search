{
  "name": "my-game",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.12.1",
  "gameInstance": {
    "gameContractVersion": "1.0.0",
    "development": {
      "schemaVersion": 1,
      "toolkit": "gameinstance",
      "distribution": "npm",
      "sdkVersion": "0.4.0",
      "sdkIdentity": "sha256:ea1705566102847f182eefdb224491872d9186cd40c003ef893ef565532ea4ec",
      "capabilities": [
        "local-simulator",
        "inspector",
        "state-editing",
        "rewind",
        "scenarios",
        "runtime-check"
      ]
    },
    "orchestrator": {
      "pollSubscribers": false
    },
    "setConfigPayload": {
      "game": {
        "secondsPerWord": 40,
        "celebrateSeconds": 6,
        "revealSeconds": 15,
        "finalLevel": 10,
        "stopGame": false,
        "musicVolume": 50,
        "soundVolume": 70,
        "voiceVolume": 80
      }
    }
  },
  "scripts": {
    "bootstrap": "node scripts/bootstrap.mjs",
    "doctor": "node scripts/bootstrap.mjs --check",
    "build": "vite build",
    "test": "vitest run",
    "test:scenarios": "vitest run src/scenarios.test.ts",
    "check:runtime": "bubbleportal runtime-check",
    "runtime:build": "node scripts/build-runtime.mjs",
    "lint": "tsc -p tsconfig.json --noEmit",
    "dev": "bubbleportal dev",
    "dev:game": "vite",
    "dev:container": "node scripts/runtime-start.mjs",
    "voice:generate": "node scripts/generate-voice.mjs",
    "voice:lipsync": "node scripts/lipsync-voice.mjs"
  },
  "dependencies": {
    "@bubbleportal/sdk": "0.4.0",
    "@rive-app/canvas": "2.44.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "zod": "^3.25.67"
  },
  "devDependencies": {
    "@bubbleportal/devtools": "0.4.0",
    "@types/node": "^22.15.30",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^4.5.2",
    "typescript": "^5.8.3",
    "vite": "^6.3.5",
    "vitest": "^3.2.4"
  }
}
