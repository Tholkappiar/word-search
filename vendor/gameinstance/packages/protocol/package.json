{
  "name": "@repo/protocol",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./src/index.ts",
  "exports": {
    "./sdk-identity": {
      "types": "./src/sdk-identity.ts",
      "default": "./dist/sdk-identity.js"
    },
    ".": {
      "types": "./src/index.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "test": "vitest run",
    "lint": "tsc -p tsconfig.json --noEmit",
    "dev": "tsc -w -p tsconfig.json --preserveWatchOutput"
  },
  "dependencies": {
    "zod": "^3.25.67"
  }
}
